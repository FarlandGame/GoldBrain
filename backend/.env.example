# GoldBrain private alpha
GOLDBRAIN_ENVIRONMENT=development
GOLDBRAIN_DEBUG=true
GOLDBRAIN_DATABASE_URL=postgresql+psycopg://goldbrain:goldbrain_dev_only@localhost:5432/goldbrain
GOLDBRAIN_AUTO_CREATE_TABLES=false
GOLDBRAIN_REDIS_URL=redis://localhost:6379/0
GOLDBRAIN_PRIVATE_API_KEY=change-me-before-network-use
GOLDBRAIN_JWT_SECRET=replace-with-a-long-random-secret
GOLDBRAIN_ACCESS_TOKEN_MINUTES=15
GOLDBRAIN_REFRESH_TOKEN_DAYS=30
# Phase 3: authenticated transactional email, server-side only. No messages
# are sent and signup cannot finish until a real sender is configured.
GOLDBRAIN_SMTP_HOST=
GOLDBRAIN_SMTP_PORT=465
GOLDBRAIN_SMTP_USERNAME=
GOLDBRAIN_SMTP_PASSWORD=
GOLDBRAIN_SMTP_FROM_EMAIL=
GOLDBRAIN_SMTP_FROM_NAME=GoldBrain
# Allowed transports: ssl (usually 465) or starttls (usually 587).
GOLDBRAIN_SMTP_SECURITY=ssl
GOLDBRAIN_SMTP_TIMEOUT_SECONDS=10
GOLDBRAIN_RATE_LIMIT_PER_MINUTE=120
GOLDBRAIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Market providers (server-side only)
NAVASAN_API_KEY=
COINGECKO_DEMO_API_KEY=
GOLDBRAIN_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3/
GOLDBRAIN_COINGECKO_MIN_QUOTE_INTERVAL_SECONDS=60
GOLDBRAIN_NAVASAN_BASE_URL=https://api.navasan.tech/
# Free tier: 120 requests/month; quote refresh at most once/8h to reserve quota.
GOLDBRAIN_NAVASAN_MIN_QUOTE_INTERVAL_SECONDS=28800
GOLDBRAIN_NAVASAN_MONTHLY_REQUEST_BUDGET=90
GOLDBRAIN_WALLEX_BASE_URL=https://api.wallex.ir/
GOLDBRAIN_NOBITEX_BASE_URL=https://api.nobitex.ir/
GOLDBRAIN_ZARIX_BASE_URL=https://zarix.online/api/
GOLDBRAIN_GOLD_API_BASE_URL=https://api.gold-api.com/
GOLDBRAIN_MARKET_MAX_QUOTE_AGE_SECONDS=300
GOLDBRAIN_MARKET_COLLECTION_INTERVAL_SECONDS=60
GOLDBRAIN_WALLEX_RATE_LIMIT_PER_MINUTE=120
GOLDBRAIN_NOBITEX_RATE_LIMIT_PER_MINUTE=60
GOLDBRAIN_NAVASAN_RATE_LIMIT_PER_MINUTE=60

# Backend-only chat/narrative gateway. Never put this key in Flutter or build
# defines. Development uses free models only; no paid subscription required.
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://openrouter.ai/api/v1
GAPGPT_MODEL=qwen/qwen3.8-27b:free
