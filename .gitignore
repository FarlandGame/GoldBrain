/android/app/profile
/android/app/release

# Android local configuration and signing credentials
.gradle/
**/android/local.properties
**/android/key.properties
*.jks
*.keystore

# GoldBrain workspace / Python backend
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
backend/.venv/
backend/.env
/.goldbrain/
backend/data/*.db
backend/data/*.sqlite*
.env
.env.*
!.env.example

# Nested Flutter build/cache paths
frontend/.dart_tool/
frontend/.pub/
frontend/build/
frontend/coverage/

# Local provider secrets / exports
*.pem
*.key
secrets/

# Assets intentionally kept out of the GitHub repository
